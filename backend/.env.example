# Cấu hình API LLM (Mặc định dùng OpenAI pattern)
# Có thể dùng trực tiếp key của OpenAI, hoặc Gemini (qua compatibility endpoint), hoặc các dịch vụ khác.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Nếu dùng Google Gemini qua endpoint tương thích OpenAI:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIzaSy...
# MODEL_NAME=gemini-2.5-flash
